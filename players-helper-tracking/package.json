{
  "name": "players-helper-tracking",
  "version": "1.0.0",
  "description": "Conformance matrix for the @dcl/sdk/players tracking rewrite: arrival thresholds, duplicate-address resolution, payload aliasing, system ordering, and the roster accessors",
  "license": "Apache-2.0",
  "scripts": {
    "start": "sdk-commands start",
    "deploy": "sdk-commands deploy",
    "build": "sdk-commands build",
    "upgrade-sdk": "npm install --save-dev @dcl/sdk@latest",
    "upgrade-sdk:next": "npm install --save-dev @dcl/sdk@next",
    "verify": "node_modules/.bin/esbuild verify/run.ts --bundle --platform=node --outfile=verify/out.cjs --log-level=warning && node verify/out.cjs"
  },
  "devDependencies": {
    "@dcl/ecs": "7.26.0",
    "@dcl/js-runtime": "7.26.0",
    "@dcl/sdk": "7.26.0",
    "typescript": "^5.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "trailingComma": "none"
  }
}
